<style>
	.wisiwig---body .card {
		border: none;
	}

	.wisiwig---body .card-img {
		border-radius: 0;
	}

	.wisiwig---body .vgr-cards .card {
		display: flex;
		flex-flow: wrap;
		flex: 100%;
		margin-bottom: 40px;
		width: 100%;
		border-radius: 20px;
		background: linear-gradient(107deg, #FFF 38.2%, rgba(255, 255, 255, 0.96) 97.98%);
		box-shadow: 0 1px 68.9px 0 rgba(97, 106, 178, 0.20);
		padding: 30px;
		align-items: center;
	}

	{# .wisiwig---body .vgr-cards .card:nth-child(even) .card-img-body {
		order: 2;
	} #}

	.wisiwig---body .vgr-cards .card:nth-child(even) .card-body {
		padding-left: 0;
		padding-right: 1.25rem;
	}

	@media(max-width: 576px) {
		.wisiwig---body .vgr-cards .card {
			display: block;
		}
	}

	.wisiwig---body .vgr-cards .card-img-body {
		overflow: hidden;
		position: relative;
	}

	@media(max-width: 576px) {
		.wisiwig---body .vgr-cards .card-img-body {
			width: 100%;
			height: 200px;
			margin-bottom: 20px;
		}
	}

	.wisiwig---body .vgr-cards .card-img {
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 20px;
	}

	@media(max-width: 1140px) {
		.wisiwig---body .vgr-cards .card-img {
			margin: 0;
			transform: none;
			width: 100%;
			height: auto;
		}
	}

	.wisiwig---body .vgr-cards .card-body {
		flex: 2;
		padding: 0 0 0 1.25rem;
	}

	@media(max-width: 576px) {
		.wisiwig---body .vgr-cards .card-body {
			padding: 0;
		}
	}
</style>
